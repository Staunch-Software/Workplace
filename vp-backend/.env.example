# ============================================================
# Copy to .env and fill in. Never commit the real .env.
# ============================================================

# --- Vessel Performance database (the pipeline's own database) ---
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vessel_perf

# --- Workplace login ---
# Read-only access to the workplace control database (users, roles, permissions). Use a role that can only
# SELECT id, full_name, email, role, is_active, permissions from users.
CONTROL_DATABASE_URL=postgresql://vp_ctl_ro:password@localhost:5432/workplace_control
# Must be the same value the workplace backend signs its tokens with.
SECRET_KEY=

# --- CORS (comma-separated; the workplace origins) ---
CORS_ORIGINS=http://localhost:5173

# --- Background jobs started inside the API process (0 disables) ---
FLEET_STATUS_INTERVAL_MINUTES=30
EMAIL_SCRAPER_INTERVAL_MINUTES=15

# --- WNI (Weathernews) ---
WN_USERNAME=
WN_PASSWORD=
WNI_LOGIN_URL=

# --- MariApps (Microsoft SSO account without MFA, for the headless scraper) ---
MARIAPPS_URL=
MARIAPPS_USERNAME=
MARIAPPS_PASSWORD=
MARIAPPS_DOWNLOAD_DIR=
MARIAPPS_HEADLESS=true

# --- Wartsila FOS (Microsoft SSO) ---
WARTSILA_USERNAME=
WARTSILA_PASSWORD=

# --- Eyegauge / Sea Vision ---
EYEGAUGE_BASE_URL=https://sea.vision
EYEGAUGE_USERNAME=
EYEGAUGE_PASSWORD=
EYEGAUGE_VESSEL_IMO=9811048

# --- Azure Blob Storage (MariApps bunker report attachments) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=mariapps-bunker-attachments

# --- Microsoft Graph (TUFMAX inbox polling) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
IMAP_EMAIL=

# --- Outgoing mail (weekly / data-quality / voyage reports) ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=
MAIL_FROM_NAME=Vessel Performance
MAIL_TO=
MAIL_CC=

# --- Voyage report PDF ---
# Address the headless browser opens to render the voyage report (the workplace /vp/ page).
VOYAGE_PDF_FRONTEND_URL=http://localhost:5173
