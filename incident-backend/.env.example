# Incident backend's own database (create it first, e.g. CREATE DATABASE incident_db)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/incident_db
# Same values as workplace-backend: users/vessels live in the control DB, tokens are issued there.
CONTROL_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/workplace_control
SECRET_KEY=
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173

# Files and photos live in Azure Blob, like DRS / ORB. Use the same storage account as DRS (wrap in double quotes),
# or Azurite on a dev machine: "UseDevelopmentStorage=true". The two containers are created automatically.
FILE_STORAGE=blob
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_INCIDENT_CONTAINER=incident-files
AZURE_STORAGE_INCIDENT_CHAT_CONTAINER=incident-chat

# Only when FILE_STORAGE=local (throwaway dev machine, never the VM):
UPLOAD_DIR=uploads
