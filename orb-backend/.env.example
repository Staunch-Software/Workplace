# ORB's own database (existing standalone data lives here)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/orb_platform
# Workplace control database (users, vessels, permissions) - same one workplace-backend uses
CONTROL_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/workplace_control
# Must be identical to workplace-backend's SECRET_KEY / ALGORITHM: tokens are issued there
SECRET_KEY=
ALGORITHM=HS256
GEMINI_API_KEY=
# Model for extraction. If Google returns 404 "model not found" (older models are gated for
# new projects), set a current one here, e.g. a Flash model listed by your key.
GEMINI_MODEL=gemini-2.5-flash
# Optional: a cheaper model for the simple per-page calls (layout, vessel name, re-checks).
GEMINI_MODEL_LIGHT=
# Optional (non-2.5 models): minimal | low | medium | high. Lower = cheaper; check quality first.
GEMINI_THINKING_LEVEL=
# Optional: true = cache the long extraction instructions once per upload (cheaper input tokens).
GEMINI_PROMPT_CACHE=false
# Optional: prices (USD per 1M tokens) and an exchange rate for the per-upload cost estimate in the log.
GEMINI_PRICE_IN_PER_M=0.75
GEMINI_PRICE_OUT_PER_M=3.75
GEMINI_USD_INR=0
ANTHROPIC_API_KEY=
USE_MOCK_EXTRACTION=true
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
# Leave empty on Linux/VM (poppler-utils is on PATH).
# On local Windows set to your poppler bin folder, e.g.
# POPPLER_PATH=C:\poppler\poppler-26.02.0\Library\bin
POPPLER_PATH=
# Comma-separated CORS origins (the workplace frontend origins)
CORS_ORIGINS=http://localhost:5173
# Set true ONLY on local machines behind an SSL-inspecting proxy that breaks
# TLS verification. MUST stay false on the VM/production.
DISABLE_SSL_VERIFY=false
# Diagnostic-only: dumps every image sent to Gemini, raw per-page JSON
# responses, and the split-decision manifest to this folder per upload.
# Leave empty in production.
EXTRACTION_DEBUG_DIR=
# Max ORB PDF extractions allowed to run at once. Each job holds every page
# of the PDF in memory for the whole run; raising this trades memory
# headroom for shorter queue waits when multiple uploads land together.
MAX_CONCURRENT_EXTRACTIONS=1
# Azure Blob Storage - IOPP tank certificate/survey documents and ORB upload PDFs
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=iopp-documents
AZURE_STORAGE_ORB_CONTAINER=orb-uploads
# WNI fuel scraper (standalone cron job)
WNI_LOGIN_URL=
WNI_USERNAME=
WNI_PASSWORD=
WNI_VESSELS_FILE=vessels.txt
