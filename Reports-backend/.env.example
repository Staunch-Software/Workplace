# SmartPAL Report Tracker - Environment Variables
# Copy this to .env and fill in your values.

# Shared JWT Secret (must match workplace-backend SECRET_KEY)
SECRET_KEY=your-secret-key-here

# Control Plane DB (shared Users/Vessels DB from workplace-backend)
CONTROL_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/workplace_control

# Report Tracker DB
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=report_tracker

# Azure Blob Storage (reports container)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
AZURE_CONTAINER_NAME=smartpal-reports

# SmartPAL Credentials (for Playwright scraper)
SMARTPAL_EMAIL=pms@ozellar.com
SMARTPAL_PASSWORD=your_smartpal_password
SMARTPAL_BASE_URL=https://maritime.smartpal.io

# Scraper Schedule (UTC time, runs daily)
SCRAPER_CRON_HOUR=2
SCRAPER_CRON_MINUTE=0

# Path to the Excel file with vessel/report configuration (offline regen only)
REPORT_EXCEL_PATH=./data/reports_config.xlsx

# JSON snapshot of the 45 default report configs, used by "Assign 45 Defaults"
DEFAULT_REPORTS_JSON_PATH=./data/default_reports_config.json

# AEPMS (Engine Performance) auto-push -- service account used to upload
# scraped ME/AE monthly reports into AEPMS automatically after each scrape.
# Must be a SHORE/ADMIN role account in AEPMS (VESSEL role is rejected).
AEPMS_BASE_URL=https://workplace.ozellar.com/aepms
AEPMS_SERVICE_EMAIL=admin@ozellar.com
AEPMS_SERVICE_PASSWORD=12345
# Set to false ONLY if AEPMS_BASE_URL is an internal/private address with a
# self-signed cert. Leave true if it's reachable over the public internet.
AEPMS_VERIFY_SSL=true
