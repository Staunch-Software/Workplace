# Reference only: the real file is C:\WORKPLACE\orb_backend\.env
STORAGE_MODE=offline
VESSEL_IMO=
# Same key as the VM's SYNC_API_KEY (and DRS / Reports)
SYNC_API_KEY=
# The VM's ORB root, as the vessel reaches it
CLOUD_BASE_URL=https://workplace.ozellar.com/orb
SYNC_INTERVAL_SECONDS=60

DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@localhost:5432/workplace_orb
CONTROL_DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@localhost:5432/workplace_control
# Same SECRET_KEY / ALGORITHM as workplace-backend on this vessel
SECRET_KEY=
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:8080

# Local Azurite on the vessel (files are read from here) ...
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# ... and the VM's Azure account (files are copied up and down through it)
CLOUD_STORAGE_CONNECTION_STRING=

USE_MOCK_EXTRACTION=true
UPLOAD_DIR=uploads
# Leave empty unless pages of PDFs must be rendered and poppler is installed here
POPPLER_PATH=
