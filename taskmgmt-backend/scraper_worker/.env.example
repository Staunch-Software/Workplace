# Same Postgres DBs used by taskmgmt-backend itself (see ../.env)
TASKMGMT_DATABASE_URL=postgresql+psycopg2://user:password@localhost/taskmgmt_db
CONTROL_DATABASE_URL=postgresql+psycopg2://user:password@localhost/workplace_control

# SmartPAL (Azure AD OWIN SSO)
SMARTPAL_BASE_URL=https://smartpal.ozellar.com
SMARTPAL_USERNAME=placeholder@ozellar.com
SMARTPAL_PASSWORD=placeholder

# DNV Veracity
DNV_LOGIN_URL=https://login.veracity.com/a68572e3-63ce-4bc1-acdc-b64943502e9d/b2c_1a_signinwithadfsidp/oauth2/v2.0/authorize?flowtype=hybrid&client_id=72cf8a4d-c128-4744-807a-49e5df96151e&redirect_uri=https%3A%2F%2Fmaritime.dnv.com%2Fauthentication%2Fsignin-oidc-ext&response_type=id_token&scope=openid%20profile&response_mode=form_post
DNV_USERNAME=placeholder@ozellar.com
DNV_PASSWORD=placeholder

# ABS MyFreedom / Eagle
ABS_LOGIN_URL=https://login.eagle.org/absauthprod.onmicrosoft.com/b2c_1a_abs_signin_mfa/oauth2/v2.0/authorize?client_id=df694ded-413f-4f27-8646-04441d37be83&scope=openid%20profile%20offline_access&redirect_uri=https%3A%2F%2Fwww.eagle.org%2Fportal%2F&response_mode=fragment&response_type=code
ABS_USERNAME=placeholder@ozellar.com
ABS_PASSWORD=placeholder

# IRClass — plain login form (NOT B2C/OAuth), POSTs UserName/Password directly.
# Username is a plain account name (e.g. "ozellar_marine"), not necessarily an email.
IRS_HOMEPAGE_URL=https://www.irclass.org/
IRS_USERNAME=placeholder
IRS_PASSWORD=placeholder

# Where downloaded PDF reports are staged before parsing
DOWNLOAD_DIR=./downloads
