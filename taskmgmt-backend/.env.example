CONTROL_DATABASE_URL=postgresql+asyncpg://user:password@localhost/workplace_control
TASKMGMT_DATABASE_URL=postgresql+asyncpg://user:password@localhost/taskmgmt_db
APP_JWT_SECRET=change-me
APP_JWT_ALGORITHM=HS256
# Must be IDENTICAL to workplace-backend's SECRET_KEY — that's what actually signs
# the login JWT (see workplace-backend/app/core/security.py). Leaving this blank
# will cause every request here to 401 with a valid-looking token.
SECRET_KEY=your-super-secret-key-must-match-drs-backend
FRONTEND_URL=http://localhost:5173
